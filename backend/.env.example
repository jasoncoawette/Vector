VECTOR_HOST=127.0.0.1
VECTOR_PORT=7777
VECTOR_BUILD_HASH=dev

# Brain + agents
VECTOR_ANTHROPIC_API_KEY=

# TTS
VECTOR_ELEVENLABS_API_KEY=
VECTOR_ELEVENLABS_VOICE_ID=default

# Local-only STT (whisper.cpp model name; no API key needed)
VECTOR_WHISPER_MODEL=small.en

# Auth for mutation endpoints + mobile companion (empty = open dev mode)
VECTOR_BACKEND_BEARER=

# Optional Linear sync
VECTOR_LINEAR_API_KEY=
