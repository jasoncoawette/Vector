VECTOR_HOST=127.0.0.1
VECTOR_PORT=7777
VECTOR_BUILD_HASH=dev

# Brain + agents
VECTOR_ANTHROPIC_API_KEY=

# TTS
VECTOR_ELEVENLABS_API_KEY=
VECTOR_ELEVENLABS_VOICE_ID=default

# Local-only STT (whisper.cpp model name; no API key needed)
VECTOR_WHISPER_MODEL=small.en

# Auth for mutation endpoints + mobile companion (empty = open dev mode)
VECTOR_BACKEND_BEARER=

# Optional Linear sync
VECTOR_LINEAR_API_KEY=

# Optional Linear webhook receiver (HMAC-SHA256 over raw body)
VECTOR_LINEAR_WEBHOOK_SECRET=

# Obsidian vault — knowledge base. If the path doesn't exist Vector
# creates it. Set to your existing vault to share notes with Obsidian.
VECTOR_OBSIDIAN_VAULT=$HOME/Obsidian/Stratus

# Google Maps API key (Geocoding + Directions + Places APIs enabled).
# Restrict to your Mac mini's IP at console.cloud.google.com.
VECTOR_GOOGLE_MAPS_API_KEY=

# Spend ceiling for today across all agents + verifier.
# /costs raises over_budget_today once today's total exceeds this.
# 0 = no alert (data still tracked).
VECTOR_DAILY_BUDGET_USD=0

# Structured logging.
# VECTOR_LOG_LEVEL: DEBUG | INFO (default) | WARNING | ERROR
# VECTOR_LOG_FORMAT: json (default) | plain
VECTOR_LOG_LEVEL=INFO
VECTOR_LOG_FORMAT=json
