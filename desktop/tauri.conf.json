{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vector",
  "version": "0.1.0",
  "identifier": "industries.stratus.vector",
  "build": {
    "frontendDist": "../frontend/build",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "pnpm --dir ../frontend dev",
    "beforeBuildCommand": "pnpm --dir ../frontend build"
  },
  "app": {
    "windows": [
      {
        "title": "Vector",
        "width": 420,
        "height": 480,
        "resizable": true,
        "alwaysOnTop": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:7777 ws://127.0.0.1:7777; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false
  }
}
