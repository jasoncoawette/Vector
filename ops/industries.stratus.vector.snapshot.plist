<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hourly SQLite snapshot to the configured backup directory.
  Atomic via sqlite3's online backup API (.backup); safe while backend
  is writing.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>industries.stratus.vector.snapshot</string>

    <key>ProgramArguments</key>
    <array>
        <string>__REPO__/ops/snapshot.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/Vector/snapshot.out.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/Vector/snapshot.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>

    <key>LowPriorityIO</key>
    <true/>
</dict>
</plist>
